VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Observability & Diagnostics (Privacy-Safe Error Monitoring)
VITE_APP_RELEASE=1.0.0
# Optional sink endpoint for collecting sanitized error events (beacon / POST)
# VITE_OBSERVABILITY_ENDPOINT=https://your-observability-sink.example.com/api/events

# E2E Test Suite (Non-Production / Isolated Environment)
E2E_BASE_URL=http://localhost:4173
