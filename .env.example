E2E_OWNER_EMAIL=owner@e2e-test.com
E2E_OWNER_PASSWORD=e2e_secure_password
E2E_CUSTOMER_EMAIL=customer@e2e-test.com
E2E_CUSTOMER_PASSWORD=e2e_secure_password
